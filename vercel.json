{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/mcp.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/search.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/health.ts": {
      "memory": 256,
      "maxDuration": 10
    },
    "api/tokens.ts": {
      "memory": 256,
      "maxDuration": 15
    }
  },
  "routes": [
    {
      "src": "/api/mcp",
      "dest": "/api/mcp.ts"
    },
    {
      "src": "/api/tokens(/.*)?",
      "dest": "/api/tokens.ts"
    },
    {
      "src": "/api/search",
      "dest": "/api/search.ts"
    },
    {
      "src": "/api/health",
      "dest": "/api/health.ts"
    },
    {
      "src": "/agents/codebase-retrieval(/.*)?",
      "dest": "/api/search.ts"
    },
    {
      "src": "/context-canvas/list(/.*)?",
      "dest": "/api/health.ts"
    },
    {
      "src": "/search-external-sources(/.*)?",
      "dest": "/api/health.ts"
    },
    {
      "src": "/get-models(/.*)?",
      "dest": "/api/health.ts"
    },
    {
      "src": "/augment/get-models(/.*)?",
      "dest": "/api/health.ts"
    },
    {
      "src": "/get-implicit-external-sources(/.*)?",
      "dest": "/api/health.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/api/health.ts"
    }
  ]
}
