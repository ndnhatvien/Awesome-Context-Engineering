{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/mcp.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/search.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "api/health.ts": {
      "memory": 256,
      "maxDuration": 10
    }
  },
  "routes": [
    {
      "src": "/api/mcp",
      "dest": "/api/mcp.ts"
    },
    {
      "src": "/api/search",
      "dest": "/api/search.ts"
    },
    {
      "src": "/api/health",
      "dest": "/api/health.ts"
    },
    {
      "src": "/(.*)",
      "dest": "/api/health.ts"
    }
  ]
}
