# ==============================================================================
# ACE (Awesome Context Engineering) - Vercel + Supabase Environment Template
# ==============================================================================
# Configure these variables in Vercel Project Settings -> Environment Variables

# --- Supabase Storage & pgvector (Required for Cloud Storage) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
# Optional: SUPABASE_SCHEMA=public
# Optional: SUPABASE_TABLE_NAME=code_chunks
ACE_STORAGE_MODE=supabase

# --- Embedding API Configuration (Required) ---
# Supported providers: SiliconFlow, OpenAI, VoyageAI, Cohere
EMBEDDINGS_API_KEYS=your-embedding-api-key
EMBEDDINGS_BASE_URL=https://api.siliconflow.cn/v1/embeddings
EMBEDDINGS_MODEL=BAAI/bge-m3
EMBEDDINGS_DIMENSIONS=1024

# --- Reranker API Configuration (Required) ---
RERANK_API_KEYS=your-rerank-api-key
RERANK_BASE_URL=https://api.siliconflow.cn/v1/rerank
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_TOP_N=20

# --- ACE Engine Settings ---
ACE_PROFILE=balanced
NODE_ENV=production
LOG_LEVEL=info
